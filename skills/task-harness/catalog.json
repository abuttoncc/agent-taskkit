{
  "schema": "ablemind.task-harness/v1",
  "name": "task-harness",
  "version": "0.4.0",
  "templates": [
    {
      "name": "general",
      "scenes": [
        "task"
      ],
      "status": "preview",
      "reference": "references/general.md",
      "title": "通用任务与交接",
      "use_when": [
        "需要分步推进、交付文件或跨会话续做，且没有适用的专门流程"
      ],
      "scene_resources": {
        "task": "references/general.md"
      },
      "assets": [
        "assets/general/request.md"
      ],
      "scripts": [
        "scripts/harness.py",
        "scripts/workspace.py"
      ]
    },
    {
      "name": "verify",
      "scenes": [
        "api"
      ],
      "status": "preview",
      "reference": "references/verify.md",
      "title": "通用验证与 API 测试",
      "use_when": [
        "验证一个明确承诺是否成立，需要逐项证据与复跑记录",
        "测试 API 的实际响应与用户要求是否一致"
      ],
      "scene_resources": {
        "api": "references/api.md"
      },
      "assets": [
        "assets/verify/spec.json",
        "assets/verify/expected.csv"
      ],
      "scripts": [
        "scripts/harness.py",
        "scripts/contract.py"
      ]
    },
    {
      "name": "research",
      "scenes": [
        "company",
        "earnings",
        "peers"
      ],
      "status": "preview",
      "reference": "references/research.md",
      "title": "金融研究：公司、财报与同业比较",
      "use_when": [
        "研究一家公司的业务、财务、竞争位置与关键风险",
        "分析财报变化、业绩质量、预期差与验证指标",
        "在统一口径下比较同业公司"
      ],
      "scene_resources": {
        "company": "references/finance-company.md",
        "earnings": "references/finance-earnings.md",
        "peers": "references/finance-peers.md"
      },
      "methods": [
        "references/finance-methods.md"
      ],
      "assets": [
        "assets/research/request.md",
        "assets/research/findings.md",
        "assets/research/review.md",
        "assets/research/report.md",
        "assets/research/research.json",
        "assets/research/metrics.json",
        "assets/verify/expected.csv"
      ],
      "scripts": [
        "scripts/harness.py",
        "scripts/research.py",
        "scripts/finance.py"
      ]
    }
  ],
  "requirements": {
    "python": ">=3.9",
    "packages": []
  },
  "verified": {
    "scope": "Local contract, installation and preservation tests; no cross-runtime or efficiency claim."
  },
  "distribution": {
    "mode": "bundled",
    "update_source": "https://github.com/abuttoncc/agent-taskkit/releases",
    "repository": "https://github.com/abuttoncc/agent-taskkit"
  },
  "shared": {
    "rules": "references/red-lines.md",
    "operations": "references/operations.md",
    "installation": "INSTALL.md",
    "workspace": "references/workspace.md"
  }
}
