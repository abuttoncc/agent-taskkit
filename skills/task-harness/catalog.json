{
  "schema": "ablemind.task-harness/v1",
  "name": "task-harness",
  "version": "0.5.0",
  "templates": [
    {
      "name": "general",
      "scenes": [
        "task"
      ],
      "status": "preview",
      "reference": "references/general.md",
      "title": "通用任务与交接",
      "use_when": [
        "需要分步推进、交付文件或跨会话续做，且没有适用的专门流程"
      ],
      "scene_resources": {
        "task": "references/general.md"
      },
      "assets": [
        "assets/general/request.md"
      ],
      "scripts": [
        "scripts/harness.py",
        "scripts/workspace.py",
        "scripts/contract.py"
      ]
    },
    {
      "name": "verify",
      "scenes": [
        "api"
      ],
      "status": "preview",
      "reference": "references/verify.md",
      "title": "通用验证与 API 测试",
      "use_when": [
        "验证一个明确承诺是否成立，需要逐项证据与复跑记录",
        "测试 API 的实际响应与用户要求是否一致"
      ],
      "scene_resources": {
        "api": "references/api.md"
      },
      "assets": [
        "assets/verify/spec.json",
        "assets/verify/expected.csv"
      ],
      "scripts": [
        "scripts/harness.py",
        "scripts/contract.py"
      ],
      "definition": "spec.json",
      "report": "outputs/*-comparison.json"
    }
  ],
  "requirements": {
    "python": ">=3.9",
    "packages": []
  },
  "verified": {
    "scope": "Local contract, handoff, installation and preservation tests; no cross-runtime or efficiency claim."
  },
  "distribution": {
    "mode": "bundled",
    "update_source": "https://github.com/abuttoncc/agent-taskkit/releases",
    "repository": "https://github.com/abuttoncc/agent-taskkit"
  },
  "shared": {
    "rules": "references/red-lines.md",
    "operations": "references/operations.md",
    "installation": "INSTALL.md",
    "workspace": "references/workspace.md"
  },
  "extensions": {
    "research": {
      "skill": "finance-research",
      "title": "金融研究：公司、财报与同业比较",
      "scenes": [
        "company",
        "earnings",
        "peers"
      ],
      "definition": "request.md",
      "report": "outputs/research-review-*.json",
      "note": "由 finance-research 创建与检查；task-harness 负责总览、交接与交付冻结。"
    }
  },
  "hook": {
    "script": "scripts/harness.py",
    "command": "hook",
    "events": [
      "SessionStart",
      "Stop"
    ],
    "optional": true
  }
}
